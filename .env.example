# ==============================================================================
# ScholarFlow · Environment Configuration Template
# Copy this file to .env and configure values before starting the application
# ==============================================================================

# Flask Core Configuration
FLASK_APP=app.py
FLASK_DEBUG=False

# Cryptographic Session Secret Key (Generate a random 32+ character hex string in production)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=scholarflow-dev-secret-key-replace-in-production

# Network Host & Port Binding
HOST=127.0.0.1
PORT=5000

# Optional Custom SQLite Database File Path (Default: student_tasks.db in root)
# DATABASE_PATH=student_tasks.db

